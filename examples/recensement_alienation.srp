# recensement_alienation.srp
# One-off conversion of RECENSEMENT_ALIENATIONFREEZONE (aZgfhSHoEaimjgdwuVsavS.xlsx)
#
# Conversion gaps vs. original XLSForm:
# - Language selector (KoboToolbox multilingual) omitted — form is French only
# - Cross-field validation "at least one of passport or CNI" not enforced — both optional
# - "Pièces justificatives" repeat has a relevant condition (show only when option_1 or
#   option_2 is selected) — conditional repeat display not supported in SRP v1; always shown
# - Phone prefix dropdown uses placeholder options (not real international dialling codes)
# - "Caractérisation des Préjudices" section has placeholder option labels — replace when finalised
# - XLSForm datetime type mapped to DatePicker (date only; time component lost)
# - Mixed matrix (Oui/Non column + integer column) split into SingleSelectMatrix + Number questions

page "intro" do
  title "RECENSEMENT ALIENATIONFREEZONE"

  Notification "confidentialite" do
    text "– Les renseignements fournis sont traités de manière confidentielle –"
  end
end

page "identite_parent" do
  title "Votre Identité (parent impacté)"

  SingleSelect "declarant_appel" do
    text "Formule d'Appel"
    option "Mme"
    option "M"
    option "Mx"
  end

  SingleSelect "titre" do
    text "Titre"
    option "Dr."
    option "Me"
    option "Prof."
  end

  OpenEnded "declarant_prenom" do
    text "Prénom(s)"
    required
  end

  OpenEnded "declarant_nom_de_famille" do
    text "Nom de Famille"
    required
  end

  SingleSelect "declarant_genre" do
    text "Genre"
    option "Mère"
    option "Père"
    required
  end

  OpenEnded "declarant_nom_jeune_fille" do
    text "Nom de Jeune-Fille"
  end

  OpenEnded "declarant_email" do
    text "Adresse E-Mail"
    required
  end

  DatePicker "declarant_date_naissance" do
    text "Date de Naissance"
    required
  end

  OpenEnded "declarant_lieu_naissance" do
    text "Lieu de Naissance"
    required
  end

  Dropdown "declarant_pays_naissance" do
    text "Pays de Naissance"
    required
    option "Afghanistan"
    option "Åland Islands"
    option "Albania"
    option "Algeria"
    option "American Samoa"
    option "Andorra"
    option "Angola"
