repeat "enfants" do
  label "Enfant"
  min 1

  # État civil selon les inscriptions devant les autorités françaises
  OpenEnded "enfant_prenoms_fr" do
    text "Prénoms"
    required
  end

  OpenEnded "enfant_nom_famille_fr" do
    text "Nom de Famille"
  end

  # État civil selon les inscriptions devant les autorités germaniques
