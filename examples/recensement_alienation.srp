page "prejudices" do
  title "Caractérisation des Préjudices"

  # TODO: placeholder options — replace with actual harm category labels when form is finalised
  MultiSelect "caracterisation_prejudices" do
    text "Caractérisation des Préjudices"
    option "Option 1"
    option "Option 2"
  end

  MultiSelect "type_prejudice" do
    text "New Question"
    option "Option 1"
    option "Option 2"
  end

  Slider "niveau_prejudice" do
    text "Enter a number within a specified range"
    min_value 1
    max_value 10
  end

  # TODO: placeholder options — replace with actual answer labels
  Dropdown "comment_avez_vous" do
    text "Comment avez-vous ?"
    option "Option 1"
    option "Option 2"
    option "Option 3"
    option "Option 4"
    option "Option 5"
  end

  # XLSForm models this as a group-of-groups matrix (Kobo appearance: w3 horizontal-compact)
  # The original also has an integer "score" column alongside the Oui/Non — see Number questions below
  SingleSelectMatrix "impact_enfant" do
    text "New Question"
    column "Oui"
    column "Non"
    row "Le contact avec mon enfant est altéré"
    row "Zeile"
  end

  # Integer column from the XLSForm matrix — split into separate Number questions
  Number "impact_score_contact" do
    text "Score — Le contact avec mon enfant est altéré"
    allow_decimals false
  end

  Number "impact_score_zeile" do
    text "Score — Zeile"
    allow_decimals false
  end
end

# XLSForm shows this repeat only when option_1 or option_2 is selected in caracterisation_prejudices
# (relevant field condition) — conditional repeat display not supported in SRP v1; always shown
repeat "pieces_justificatives" do
  label "Pièce justificative"

  OpenEnded "description_prejudice" do
    text "Description du Préjudice"
    required
  end

  # XLSForm conditionally shows these on description_prejudice != '' — show_only_if inside repeats
  # is not supported in SRP v1; all are shown
  MediaUpload "preuve_pdf" do
    text "Preuve PDF"
    accept "application/pdf"
  end

  MediaUpload "preuve_image" do
    text "Preuve Image"
    accept "image/*"
  end

  MediaUpload "preuve_audio" do
    text "Preuve Audio"
    accept "audio/*"
  end

  MediaUpload "preuve_video" do
    text "Preuve Vidéo"
    accept "video/*"
  end

  # XLSForm uses datetime type — SRP DatePicker is date-only; time component not captured
  DatePicker "date_prejudice" do
    text "Date et Horaire du Préjudice"
  end
end
