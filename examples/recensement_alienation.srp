repeat "telephones" do
  label "Téléphone"

  SingleSelect "type_ligne" do
    text "Type de ligne téléphonique"
    option "Portable"
    option "Ligne fixe"
  end

  # TODO: replace Option 1/2 with real international dialling code list
  Dropdown "prefix_international" do
    text "Préfix international"
    option "Option 1"
    option "Option 2"
  end

  OpenEnded "numero_telephone" do
    text "Numéro de Téléphone"
  end
end

page "residence_principale" do
  title "Vos Lieux de Résidence"

  Notification "titre_residence_principale" do
    text "Votre Lieu de Résidence principale actuelle"
