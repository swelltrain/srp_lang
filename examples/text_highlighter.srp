title "Text Highlighter Test Survey"

page "intro" do
  Notification "welcome" do
    text "This survey tests the TextHighlighter question type."
  end
end

page "ad_copy" do
  TextHighlighter "ad_reactions" do
    text "Highlight phrases you like or dislike in this ad copy."
    passage "Experience the future of coffee with our revolutionary BrewMaster Pro. Every morning deserves a perfect cup crafted just for you. Our patented SmartBrew technology learns your preferences and adjusts temperature, strength, and timing to deliver barista-quality coffee at home. Say goodbye to bitter disappointments and hello to consistent perfection. Join over two million satisfied customers who start every day the BrewMaster way."
    categories ["Like", "Dislike", "Confusing"]
    min_highlights 1
    max_highlights 10
    required
  end
end

page "simple" do
  TextHighlighter "key_points" do
    text "Highlight the most important points in this passage."
    passage "Customer satisfaction is our top priority. We offer a 30-day money-back guarantee on all products. Our support team is available 24/7 to assist you. Free shipping on orders over $50."
    categories ["Important", "Not Important"]
  end
end

page "done" do
  action :complete

  Notification "farewell" do
    text "Thank you for completing the text highlighter test survey."
  end
end
